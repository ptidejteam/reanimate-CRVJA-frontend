' Lesson 8: Coffee and Beer have independent counters and deadlines.
Screen Open 0,320,256,16,Lowres
Load "tutorial_bank.abk",1

' Image indexes: Coffee 0, Beer 1, Normal 2, Energy 3, Crazy 4.
PLAYER_X=144 : PLAYER_Y=144 : PLAYER_FACE=2
COFFEE_X=32 : BEER_X=256
COFFEE_COUNT=0 : BEER_COUNT=0
COFFEE_READY_AT=0 : BEER_READY_AT=0
Timer=0

Text 8,8,"Coffee & Beer (WASD)"
Sprite 1,PLAYER_X,PLAYER_Y,PLAYER_FACE
Sprite 2,COFFEE_X,96,0
Sprite 3,BEER_X,192,1

Do
  ' Key State uses scan codes: W=$11, A=$1E, S=$1F, D=$20.
  If Key State($11)
    PLAYER_Y=Max(64,PLAYER_Y-2)
  End If
  If Key State($1F)
    PLAYER_Y=Min(224,PLAYER_Y+2)
  End If
  If Key State($1E)
    PLAYER_X=Max(0,PLAYER_X-2)
  End If
  If Key State($20)
    PLAYER_X=Min(288,PLAYER_X+2)
  End If
  Sprite 1,PLAYER_X,PLAYER_Y,PLAYER_FACE

  If COFFEE_READY_AT>0
    If Timer>=COFFEE_READY_AT
      ' Alternate the x position between 32 and 256.
      COFFEE_X=288-COFFEE_X
      COFFEE_READY_AT=0
      Sprite 2,COFFEE_X,96,0
    End If
  End If
  If BEER_READY_AT>0
    If Timer>=BEER_READY_AT
      BEER_X=288-BEER_X
      BEER_READY_AT=0
      Sprite 3,BEER_X,192,1
    End If
  End If

  ' A zero deadline means the item is available to collect.
  If COFFEE_READY_AT=0
    ' The range 2 To 2 tests the player against Coffee only.
    If Sprite Col(1,2 To 2)=-1
      COFFEE_COUNT=COFFEE_COUNT+1
      PLAYER_FACE=3
      ' Timer counts 50 ticks per second: 250 ticks is 5 seconds.
      COFFEE_READY_AT=Timer+250
      ' Hide coffee until the respawn check shows it again.
      Sprite Off 2
      Sprite 1,PLAYER_X,PLAYER_Y,PLAYER_FACE
    End If
  End If
  If BEER_READY_AT=0
    If Sprite Col(1,3 To 3)=-1
      BEER_COUNT=BEER_COUNT+1
      PLAYER_FACE=4
      BEER_READY_AT=Timer+250
      Sprite Off 3
      Sprite 1,PLAYER_X,PLAYER_Y,PLAYER_FACE
    End If
  End If

  ' Text at the same coordinates updates the existing display.
  COFFEE_TEXT$="Coffees "+COFFEE_COUNT+"/3"
  BEER_TEXT$="Beers "+BEER_COUNT+"/3"
  Text 8,32,COFFEE_TEXT$
  Text 184,32,BEER_TEXT$
Loop
