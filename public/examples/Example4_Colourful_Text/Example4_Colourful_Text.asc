Screen Open 1,640,400,16,Hires
Curs Off

COLOUR_VAR=0

For I=0 To 35
    Paper COLOUR_VAR
    Ink COLOUR_VAR + 1

    Text 10,10,"Code Revival via JavaScript for AMOS"
    Text 20+I*10,20+I*10,"CRVJA Is Not AMOS"

    Wait 5

    COLOUR_VAR = COLOUR_VAR + 1
    If COLOUR_VAR > 14
        COLOUR_VAR = 0
    End If
Next
