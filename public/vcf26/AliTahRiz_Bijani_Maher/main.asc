'                   Ali-Tah-Riz: Tetriz                          '
''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''

' ==========
' Authors: Ali Maher, Tahereh Bijani 
' Game instructions: blocks fall, fill a row to clear it
' Level 1: only 1x1 blocks, the bars come from level 2
' Level 3 is the end: "Banana, you did it!" under the board
' Abilities:
' - Movements -> A, D: left/right
' - Soft Drop -> the blocks are going down automatically with the arbitary gravity (no btn)
' - Hard Drop -> W, SPACE: the block falls down immediately
' - Pause -> P: pause / resume the game
' ...
' - Future works (haha):
' - Sound -> M: on/off the sound
' - Rotate -> Q: Rotate the blocks
' - New blocks -> for now we have two kinds of blocks only: squares and rectangles
' ==========

' ==========
' page configurations
' ==========
Screen Open 1,676,450,32,Lowres
Curs Off

' Colours  0 blue  1 white  2 black  3 orange  4 well  5 spare  6 light blue  7 panel
' Cells    8 purple  9 aqua  10 red  11 green 
Palette $05A,$FFF,$002,$F80,$113,$235,$8AF,$037,$B1E,$5EC,$F66,$7D2
Paper 0
Cls 0

Dim W(11,20)
For Y = 0 To 20
   For X = 0 To 11
      W(X, Y) = 0 ' empty cell
      If X = 0 or X = 11 or Y = 20
         W(X, Y) = 9 ' wall cell
      End If
   Next
Next

' VIEW() is what the well should look like this frame, SHOWN() is
' what is on screen: only the cells that differ are repainted
Dim VIEW(9,19), SHOWN(9,19)
For Y = 0 To 19
   For X = 0 To 9
      SHOWN(X, Y) = -1
   Next
Next


' ==========
' load the sprites 
' Images: 
' - 0 red 32x16
' - 1 green 16x32
' - 2 purple 16x16
' - 3 aqua 16x16
' ==========
Load "AmosBank_1.abk"
' wait to make sure the banks are loaded
Wait 10


' ==========
' pieces: 
' 1 purple, 2 aqua, 3 red bar, 4 green bar
' IMG = bank image, DX DY = where the 2nd cell is (0 0 = one cell only)
' ==========
Dim IMG(4), DX(4), DY(4)
Data 2,0,0, 3,0,0, 0,1,0, 1,0,1
For T = 1 To 4
   Read IMG(T), DX(T), DY(T)
Next

' HIT(X,Y,T) = 0 when piece T fits at X,Y
' I used Def Fn instead of Proc because i can run this multiple times in one frame
Def Fn HIT(X, Y, T) = W(X + 1, Y) + W(X + DX(T) + 1, Y + DY(T))


' ==========
' game varsss
' ==========
BX = 208 : BY = 48
K = 0 : LASTK = 0 : NEWK = 0 : HELD = 0
ACTIVE = 0 : PX = 0 : PY = 0 : PT = 0 : NEXT_T = Rnd(1) + 1
SPAWN_REQ = 1 : LOCK_NOW = 0
LAST_FALL = 0 : FALL_DELAY = 25
DIRTY = 1 : HUD = 1
SCORE = 0 : LINES = 0 : LEVEL = 1 : BEST = 0
PAUSED = 0

' K: key held this frame and NEWK = 1 on the frame the key is pressed.
' PT: falling piece (1..4), also the colour of its cells when it lands

Global BX, BY, K, NEWK, HELD, ACTIVE, PX, PY, PT, NEXT_T
Global SPAWN_REQ, LOCK_NOW, LAST_FALL, FALL_DELAY, DIRTY, HUD
Global SCORE, LINES, LEVEL, BEST

' ==========
' base screen
' ==========
Ink 1: Bar 0, 0 To 676, 24
Paper 1: Ink 0
Text 8, 2, "Ali-Tah-Riz"
Text 560, 2, "VCF 2026"

Ink 1: Bar 202, 42 To 374, 374
Ink 2: Bar 204, 44 To 372, 372

Ink 1: Bar 398, 62 To 570, 130
Ink 7: Bar 400, 64 To 568, 128

Paper 0: Ink 3
Text 16, 40, "SCORE"
Text 16, 100, "LINES"
Text 16, 160, "LEVEL"
Text 16, 220, "BEST"
Text 400, 40, "NEXT"
Text 400, 150, "CONTROLS"
Ink 6
Text 400, 178, "A D"
Text 400, 200, "S"
Text 400, 222, "W SPC"
Text 400, 244, "Q"
Text 400, 266, "P"
Text 400, 288, "M"
Text 400, 318, "OR ARROWS"
Ink 1
Text 500, 178, "MOVE"
Text 500, 200, "DOWN"
Text 500, 222, "DROP"
Text 500, 244, "Rotate (WIP)"
Text 500, 266, "PAUSE"
Text 500, 288, "SOUND (WIP)"
' Ink 6
Text 16, 400, "SOUND ON (WIP)"


' ==============
' P_SPAWN: drop a new piece in at the top
' ==============
Procedure P_SPAWN
   X = 0 : Y = 0
   PT = NEXT_T
   PX = 4 : PY = 0 : ACTIVE = 1 : LAST_FALL = Timer
   
   If Fn HIT(PX, PY, PT) > 0
      If SCORE > BEST Then BEST = SCORE
      SCORE = 0 : LINES = 0 : LEVEL = 1 : FALL_DELAY = 25
      For Y = 0 To 19
         For X = 1 To 10
            W(X, Y) = 0
         Next
      Next
   End If
   
   ' >>> change the block base on the level here >>>
   NEXT_T = Rnd(1) + 1
   If LEVEL > 1 Then NEXT_T = Rnd(3) + 1
   DIRTY = 1 : HUD = 1
End Proc

' ============================================================
' P_DRAW_HUD -> score panel and level
' ============================================================
Procedure P_DRAW_HUD
   SPX = 0 : SPY = 0 : SPI = 0
   Paper 0 : Ink 1
   Text 16, 62, SCORE
   Text 16, 122, LINES
   Text 16, 182, LEVEL
   Text 16, 242, BEST

   SPX = 476 - DX(NEXT_T) * 8 : SPY = 88 - DY(NEXT_T) * 8 : SPI = IMG(NEXT_T)
   Sprite 2, SPX, SPY, SPI
End Proc


' ==============
' P_PLAY: player input, gravity
' ==============
Procedure P_PLAY
   NX = 0 : NT = 0 : MV = 0 : GY = 0 : I = 0

   ' Move left /right
   If K = 1 or K = 2
      If NEWK = 1 Then MV = 1
      If HELD >= 5 Then MV = 1
   End If
   If MV = 1
      NX = PX - 1
      If K = 2 Then NX = PX + 1
      If Fn HIT(NX, PY, PT) = 0
         PX = NX : DIRTY = 1
      End If
   End If

   ' Rotate: red bar <-> green bar, if no room try one cell to the left (future work)
   ' To be completed later...

   ' aoft drop
   If K = 5
      If Fn HIT(PX, PY + 1,PT) = 0
         PY = PY + 1 : LAST_FALL = Timer : DIRTY = 1
      End If
   End If

   ' hard drop
   If NEWK = 1 and K = 6
      GY = PY
      For I = 1 To 20
         If Fn HIT(PX, GY + 1, PT) = 0 Then GY = GY + 1
      Next
      PY = GY : LOCK_NOW = 1 : DIRTY = 1
   End If

   ' >>> gravity
   If LOCK_NOW = 0
      If Timer - LAST_FALL >= FALL_DELAY
         LAST_FALL = Timer
         If Fn HIT(PX, PY + 1, PT) = 0
            PY = PY + 1 : DIRTY = 1
         Else
            LOCK_NOW = 1
         End If
      End If
   End If
End Proc




' ==============
' P_LOCK
' ==============
Procedure P_LOCK
   X = 0 : Y = 0 : YY = 0 : CNT = 0
   W(PX + 1, PY) = PT
   W(PX + DX(PT) + 1, PY + DY(PT)) = PT
   ACTIVE = 0

   ' Top to bottom: a full row is removed and the rows above move down
   For Y = 0 To 19
      CNT = 0
      For X = 1 To 10
         If W(X, Y) > 0 Then CNT = CNT + 1
      Next
      If CNT = 10
         For YY = Y To 1 Step -1
            For X = 1 To 10
               W(X, YY) = W(X, YY - 1)
            Next
         Next
         For X = 1 To 10
            W(X, 0) = 0
         Next
         ' Score, and faster every 10 lines
         LINES = LINES + 1
         SCORE = SCORE + 100 * LEVEL
         LEVEL = Int(LINES / 2) + 1
         FALL_DELAY = Max(5, 27 - LEVEL * 2)
         HUD = 1
      End If
   Next
   SPAWN_REQ = 1 : DIRTY = 1

   ' >>>> end of the game, level 3 is the end of the game for now
   If LEVEL >= 3
      SPAWN_REQ = 0
      If SCORE > BEST Then BEST = SCORE
      Paper 0 : Ink 3
      Text 155, 380, "Banana, you did it!" 
   End If
End Proc

' ==============
' P_DRAW_WELL: repaint the cells that changed
' ==============
Procedure P_DRAW_WELL
   X = 0 : Y = 0 :  V = 0 : X1 = 0 : Y1 = 0
   SPX = 0 : SPY = 0 : SPI = 0

   For Y = 0 To 19
      For X = 0 To 9
         VIEW(X, Y) = W(X + 1,Y)
      Next
   Next

   For Y = 0 To 19
      For X = 0 To 9
         V = VIEW(X, Y)
         If V <> SHOWN(X, Y)
            SHOWN(X, Y) = V
            X1 = BX + X * 16 : Y1 = BY + Y * 16
            ' pick the colour of the cell
            If V = 0 Then Ink 4  ' empty
            If V = 1 Then Ink 8  ' purple
            If V = 2 Then Ink 9  ' aqua
            If V = 3 Then Ink 10 ' red
            If V = 4 Then Ink 11 ' green
            ' 15 x 15 bar: the 1 pixel gap shows the black frame as grid lines
            Bar X1, Y1 To X1 + 15, Y1 + 15
         End If
      Next
   Next

   SPX = BX + PX * 16 : SPY = BY + PY * 16 : SPI =IMG(PT)
   If ACTIVE = 0 Then SPY = -64 
   Sprite 1, SPX, SPY, SPI
End Proc

' ==============
' test function bro
' ==============
Procedure Test_P
    If Key State($19) ' i key 
      Paper 0: Ink 3
      Text 500, 500, "Gooz"
   End If
End Proc


' ==============
' Main loop
' ==============
Do
   ' // key bindinfg
   K = 0
   If Key State($1E) Then K = 1 ' A
   If Key State($70) Then K = 1 ' left arrow
   If Key State($20) Then K = 2 ' D
   If Key State($71) Then K = 2 ' right arrow
   ' If Key State($10) Then K = 3 ' Q, turn (future work)
   If Key State($1F) Then K = 5 ' S
   If Key State($73) Then K = 5 ' down arrow
   If Key State($39) Then K = 6 ' SPACE
   If Key State($11) Then K = 6 ' W
   If Key State($6E) Then K = 6 ' up arrow
   If Key State($19) Then K = 8 ' P
   NEWK = 0
   If K <> LASTK
      NEWK = 1 : HELD = 0
   Else
      HELD = HELD + 1
   End If
   LASTK = K
   If K = 0 Then NEWK = 0

   ' // pause
   If NEWK = 1 and K = 8 and ACTIVE = 1
      PAUSED = 1 - PAUSED
      Paper 2 : Ink 3
      If PAUSED = 1
         Text 246, 200, "PAUSED"
      Else
         Text 246, 200, ""
         LAST_FALL = Timer
      End If
   End If

   ' // pplay
   If ACTIVE = 1 and PAUSED = 0
      P_PLAY
   End If

   ' // requests
   If LOCK_NOW = 1
      LOCK_NOW = 0
      P_LOCK
   End If
   If SPAWN_REQ = 1
      SPAWN_REQ = 0
      P_SPAWN
   End If
   If DIRTY= 1
      DIRTY = 0
      P_DRAW_WELL
   End If
   If HUD = 1
      HUD = 0
      P_DRAW_HUD
   End If

   Test_P

   Wait 1
Loop
