' Initialize game variables
CHARACTER_CURRENT_SPRITE = 1
CHARACTER_DIRECTION = 0
CHARACTER_TURN_TO_DIRECTION = 0
TILE_SIZE = 32


' Influences initial character position
PX = 4 : PY = 2
coins_collected = 0

Global TILE_OFFSET, CURRENT_SPRITE_NUMBER, MAP_SIZE_X, MAP_SIZE_Y, CHARACTER_CURRENT_SPRITE, CHARACTER_DIRECTION, CHARACTER_TURN_TO_DIRECTION, TILE_SIZE, PX, PY, coins_collected

' ==========================================
' Map Drawing Procedure
' ==========================================
Procedure P_DRAWMAP
   ' Render map tiles
   Current_Sprite_Index = 1

   For y = 0 To MAP_SIZE_Y
      For x = 0 To MAP_SIZE_X
         x13 = x * TILE_SIZE
         y13 = y * TILE_SIZE
         x23 = x13 + TILE_SIZE - 1
         y23 = y13 + TILE_SIZE - 1
         
         tileRendered = 0
         
         ' Border tiles
         If map(x, y) = 1
            Bar x13, y13 To x23, y23
            RENDER_TYPE_TWO_X= x13 + TILE_OFFSET
            RENDER_TYPE_TWO_Y= y13 + TILE_OFFSET
            Sprite Current_Sprite_Index , RENDER_TYPE_TWO_X, RENDER_TYPE_TWO_Y, 2
            Current_Sprite_Index = Current_Sprite_Index + 1
            tileRendered = 1
         End If

         ' Wall tiles
         If map(x, y) = 2
            Bar x13, y13 To x23, y23
            RENDER_TYPE_TWO_X= x13 + TILE_OFFSET
            RENDER_TYPE_TWO_Y= y13 + TILE_OFFSET
            Sprite Current_Sprite_Index , RENDER_TYPE_TWO_X, RENDER_TYPE_TWO_Y, 3
            Current_Sprite_Index = Current_Sprite_Index + 1
            tileRendered = 1
         End If

         ' Dirt tiles
         If map(x, y) = 3
            Ink 3
            Bar x13, y13 To x23, y23
            tileRendered = 1
         End If

         ' Boulder tiles
         If map(x, y) = 4
            Bar x13, y13 To x23, y23
            RENDER_TYPE_TWO_X= x13 + TILE_OFFSET
            RENDER_TYPE_TWO_Y= y13 + TILE_OFFSET
            Sprite Current_Sprite_Index , RENDER_TYPE_TWO_X, RENDER_TYPE_TWO_Y, 4
            Current_Sprite_Index = Current_Sprite_Index + 1
            tileRendered = 1
         End If

         ' Coins
         If map(x, y) = 5
            Bar x13, y13 To x23, y23
            RENDER_TYPE_TWO_X= x13 + TILE_OFFSET
            RENDER_TYPE_TWO_Y= y13 + TILE_OFFSET
            Sprite Current_Sprite_Index , RENDER_TYPE_TWO_X, RENDER_TYPE_TWO_Y, 6
            Current_Sprite_Index = Current_Sprite_Index + 1
            tileRendered = 1
         End If

         ' Goal
         If map(x, y) = 6
            Bar x13, y13 To x23, y23
            RENDER_TYPE_TWO_X= x13 + TILE_OFFSET
            RENDER_TYPE_TWO_Y= y13 + TILE_OFFSET
            Sprite Current_Sprite_Index , RENDER_TYPE_TWO_X, RENDER_TYPE_TWO_Y, 5
            Current_Sprite_Index = Current_Sprite_Index + 1
            tileRendered = 1
         End If

         ' Default empty space (if nothing else rendered)
         If tileRendered = 0
            Ink 1
            Bar x13, y13 To x23, y23
         End If
         
         ' Render Character
         If x = PX
            If y = PY
               Ink 1
               pacspritex = PX * TILE_SIZE + TILE_OFFSET
               pacspritey = PY * TILE_SIZE + TILE_OFFSET
               Sprite Current_Sprite_Index , pacspritex, pacspritey, 7
               Current_Sprite_Index = Current_Sprite_Index + 1
            End If
         End If
      Next
   Next

End Proc

' ==========================================
' Animation procedure
' ==========================================

Procedure P_UPD_ANIMATIONS

   ' Character sprite animation
   If CHARACTER_DIRECTION = 0  ' Right
      CHARACTER_CURRENT_SPRITE = 1
   End If
   
   If CHARACTER_DIRECTION = 1  ' Left
      CHARACTER_CURRENT_SPRITE = 3
   End If
   
   If CHARACTER_DIRECTION = 2  ' Up
      CHARACTER_CURRENT_SPRITE = 0
   End If
   
   If CHARACTER_DIRECTION = 3  ' Down
      CHARACTER_CURRENT_SPRITE = 2
   End If
End Proc

' ==========================================
' Input detection procedure
' ==========================================
Procedure P_GET_INPUTS
   ' Player movement input
   NX = PX : NY = PY

   If Key State($11)  ' W key
      NY = PY - 1
      CHARACTER_DIRECTION = 2
   End If
   
   If Key State($1F)  ' S key
      NY = PY + 1
      CHARACTER_DIRECTION = 3
   End If
   
   If Key State($1E)  ' A key
      NX = PX - 1
      CHARACTER_DIRECTION = 1
   End If
   
   If Key State($20)  ' D key
      NX = PX + 1
      CHARACTER_DIRECTION = 0
   End If

   If map(NX,NY) = 4
      If NX < PX ' Pushing left
         If map(NX-1, NY) = 0
         map(NX,NY) = 0
         map(NX-1, NY) = 4
         End If
      End If
      If NX > PX ' Pushing right
         If map(NX+1, NY) = 0
         map(NX,NY) = 0
         map(NX+1, NY) = 4
         End If
      End If
   End If

   If map(NX,NY) = 3
   map(NX,NY) = 0
   End If

   If map(NX,NY) = 5
   map(NX,NY) = 0
   coins_collected = coins_collected + 1
   End If
   
   If map(NX, NY) = 0
   PX = NX
   PY = NY
   End If
End Proc

' ==========================================
' Physics
' ==========================================
Procedure Simulate_All_Boulders
   For y = 0 To MAP_SIZE_Y
      For x = 0 To MAP_SIZE_X
          moving_boulders(x,y) = 0
      Next
   Next
   For y = 0 To MAP_SIZE_Y
      For x = 0 To MAP_SIZE_X
         If moving_boulders(x,y) = 0 and map(x,y) = 4
            If map(x,y+1) = 0
               If PX = x and PY = y+1
                  If last_frame_moving_boulders(x,y) = 1
                  'TODO: Replace PX=2 and PY=2 with death procedure
                  PX=2
                  PY=2
               End If
            Else
               map(x, y) = 0
               map(x,y+1) = 4
               moving_boulders(x,y+1) = 1
            End If
            Else If map(x, y+1) = 4 and map(x+1,y) = 0
            If PX=x+1 and PY=y
               If last_frame_moving_boulders(x,y) = 1
               End If
            Else
               map(x, y) = 0
               map(x+1,y) = 4
               moving_boulders(x+1,y) = 1
            End If
            End If
         End If
         
      Next
   Next
End Proc

Procedure Update_Moving_Boulders
   For y = 0 To MAP_SIZE_Y
      For x = 0 To MAP_SIZE_X
          last_frame_moving_boulders(x,y) = moving_boulders(x,y)
      Next
   Next
End Proc

' ==========================================
' Main Game Loop
' ==========================================

Ink 3
   P_DRAWMAP

Do
   Cls 2
   Simulate_All_Boulders
   Update_Moving_Boulders
   P_DRAWMAP
   P_GET_INPUTS
   ' Text 260,1300, "Coins Collected: "
   ' Text 485,1300, Coins_Collected
   Wait 3
Loop

End