' Breakout game in VCF 2.0 (2026)
' Timéo Klein, Vinicius Mioto, Yann-Gaël Guéhéneuc
Screen Open 1,640,400,16,Hires

Palette $00A,$000,$FF0,$FF0,$555,$FFF
Paper 4
Cls

Load "breakout.abk"

DIM_X=40
DIM_Y=4
PADDLE_X=10
PADDLE_Y=22
MAX_X = 630
MAX_Y = 390
NO_BRICK = 5
POS=0
PREV_COL_ID=-1
PADDLE_ID = DIM_X*DIM_Y
BALL_ID = DIM_X*DIM_Y + 1
PADDLE_DIRECTION = 0 + 2

BALL_START_X = 10
BALL_START_Y = 150
BALL_X = BALL_START_X
BALL_Y = BALL_START_Y
BALL_VEL_X = 1
BALL_VEL_Y = 1


SCORE = 0
LIVES = 3

DIM BRICK_TYPES(DIM_X * DIM_Y)

Global DIM_X, DIM_Y, PADDLE_X, PADDLE_Y, MAX_X, MAX_Y, NO_BRICK
Global POS, PREV_COL_ID, PADDLE_ID, BALL_ID
Global BRICK_TYPES, BALL_X, BALL_Y, BALL_VEL_X, BALL_VEL_Y
Global PADDLE_DIRECTION, SCORE, LIVES, BALL_START_X, BALL_START_Y

Ink 5
Text 10,10,"Score: "
Text 450,10,"Lives: "


Procedure INIT
    For y = 0 To DIM_Y-1
        For x = 0 To DIM_X-1
            BRICK_TYPES(y*DIM_X + x) = 1+y
        Next
    Next
End Proc

Procedure MY_DRAW
    Text 120,10,SCORE
    Text 550,10,LIVES
    For y = 0 To DIM_Y-1
        For x = 0 To DIM_X-1
            id=y*DIM_X + x
            brick_type=BRICK_TYPES(id)
            If brick_type = NO_BRICK
                Sprite Off id
            Else
                sprite_x=16*x
                sprite_y=16*y+50
                Sprite id, sprite_x, sprite_y, brick_type
            End If
        Next
    Next
End Proc

Procedure MOVEBALL
    BALL_X = BALL_X + BALL_VEL_X
    BALL_Y = BALL_Y + BALL_VEL_Y

    If BALL_X <= 0
        BALL_X = 0
        BALL_VEL_X = -BALL_VEL_X
    Else If BALL_X >= MAX_X
        BALL_X = MAX_X
        BALL_VEL_X = -BALL_VEL_X
    End If

    If BALL_Y <= 0
        BALL_Y = 0
        BALL_VEL_Y = -BALL_VEL_Y
    Else If BALL_Y >= MAX_Y
        BALL_Y = MAX_Y
        BALL_VEL_Y = -BALL_VEL_Y
    End If
End Proc

Procedure PADDLE_LEFT
    PADDLE_X=PADDLE_X-1/3
    PADDLE_DIRECTION = -1 + 2
    If PADDLE_X<0
         PADDLE_X=0
    End If
End Proc

Procedure PADDLE_RIGHT
    PADDLE_X = PADDLE_X + 1/3
    PADDLE_DIRECTION = 1 + 2
    If PADDLE_X > 38
        PADDLE_X = 38
    End If
End Proc

Procedure MOVE_PADLE
    PADDLE_DIRECTION = 0 + 2
    If Key State($11)  ' W (up)
    End If
    If Key State($1F)  ' S (down)
    End If
    If Key State($1E)  ' A (left)
        PADDLE_LEFT
    End If
    If Key State($70)  ' Left arrow
        PADDLE_LEFT
    End If
    If Key State($20)  ' D (right)
        PADDLE_RIGHT
    End If
    If Key State($71)  ' Right arrow
        PADDLE_RIGHT
    End If
End Proc


'-1 -> + 2 = 1
Procedure VELOCITY_UPDATE_RIGHT
    If BALL_VEL_X > 0
        BALL_VEL_X = BALL_VEL_X * 2
    Else
        BALL_VEL_X = BALL_VEL_X / 2
    End If
End Proc


'0 -> + 2 = 2
Procedure VELOCITY_UPDATE_NO_MOVE

End Proc

'1 -> + 2 = 3
Procedure VELOCITY_UPDATE_LEFT
    If BALL_VEL_X < 0
        BALL_VEL_X = BALL_VEL_X * 2
    Else
        BALL_VEL_X = BALL_VEL_X / 2
    End If
End Proc

' Half of the bounces change the ball direction
Procedure RANDOM_BOUNCE
    If Rnd(1) = 0
        ' Change the x speed by -0.4 to +0.4
        nudge_x = (Rnd(8) - 4) / 10
        BALL_VEL_X = BALL_VEL_X + nudge_x
        ' Do not let the ball go almost straight up and down
        If BALL_VEL_X > 0 AND BALL_VEL_X < 0.5
            BALL_VEL_X = 0.5
        Else If BALL_VEL_X <= 0 AND BALL_VEL_X > -0.5
            BALL_VEL_X = -0.5
        End If

        ' Change the y speed by -0.3 to +0.3, but keep it going the same way
        nudge_y = (Rnd(6) - 3) / 10
        If BALL_VEL_Y > 0
            BALL_VEL_Y = BALL_VEL_Y + nudge_y
            If BALL_VEL_Y < 0.6
                BALL_VEL_Y = 0.6
            Else If BALL_VEL_Y > 1.4
                BALL_VEL_Y = 1.4
            End If
        Else
            BALL_VEL_Y = BALL_VEL_Y - nudge_y
            If BALL_VEL_Y > -0.6
                BALL_VEL_Y = -0.6
            Else If BALL_VEL_Y < -1.4
                BALL_VEL_Y = -1.4
            End If
        End If
    End If
End Proc

Procedure CHECK_COLLISIONS
    If Sprite Col(BALL_ID, 0 to PADDLE_ID) = -1
        For sprite_id = 0 to PADDLE_ID-1
            ' Ball and Brick collision
            If Sprite Col(BALL_ID, sprite_id to sprite_id) = -1 AND sprite_id <> PREV_COL_ID AND BRICK_TYPES(sprite_id) <> NO_BRICK
                BRICK_TYPES(sprite_id) = BRICK_TYPES(sprite_id) + 1
                If BRICK_TYPES(sprite_id) = NO_BRICK
                    Sprite Off sprite_id
                    SCORE = SCORE + 50
                End If
                BALL_VEL_X = -BALL_VEL_X
                BALL_VEL_Y = -BALL_VEL_Y
                RANDOM_BOUNCE
                PREV_COL_ID = sprite_id
            End If
        Next
        ' Paddle and Ball collision
        If Sprite Col(BALL_ID, PADDLE_ID to PADDLE_ID) = -1 AND PADDLE_ID <> PREV_COL_ID

            On PADDLE_DIRECTION Proc VELOCITY_UPDATE_RIGHT, VELOCITY_UPDATE_NO_MOVE, VELOCITY_UPDATE_LEFT

            BALL_VEL_Y = -BALL_VEL_Y
            RANDOM_BOUNCE
            PREV_COL_ID = PADDLE_ID
        End If
        If PREV_COL_ID <> -1
            While Sprite Col(BALL_ID, PREV_COL_ID to PREV_COL_ID) = -1
                MOVEBALL
                Sprite BALL_ID, BALL_X, BALL_Y, 5
            Wend
        End If
        MY_DRAW
    Else
        PREV_COL_ID=-1
    End if
End Proc

' Ball below the paddle: lose one life and put the ball back at the start
Procedure CHECK_DEATH
    If BALL_Y > PADDLE_Y * 16
        LIVES = LIVES - 1
        Text 550,10,LIVES
        BALL_X = BALL_START_X
        BALL_Y = BALL_START_Y
        BALL_VEL_X = 1
        BALL_VEL_Y = 1
        PREV_COL_ID = -1
    End If
End Proc


Procedure GAME_LOOP
    MOVE_PADLE

    sprite_x=PADDLE_X * 16
    sprite_y=PADDLE_Y * 16
    Sprite PADDLE_ID, sprite_x, sprite_y, 0

    MOVEBALL

    CHECK_COLLISIONS

    CHECK_DEATH

    If LIVES <= 0 
       Cls
       Text 200,200,"Game Over"
    End If

    Sprite BALL_ID, BALL_X, BALL_Y, 5
End Proc

INIT
MY_DRAW
Do
    GAME_LOOP
Loop
